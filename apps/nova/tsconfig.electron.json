{
  "extends": "@vestra/tsconfig/library.json",
  "compilerOptions": {
    // esbuild produces the actual output (see scripts/build-electron.mjs), so
    // this config only typechecks. Bundler resolution is what esbuild actually
    // does: extensionless relative imports resolve, and importing a
    // `"type": "module"` workspace package is not an error, because the bundle
    // erases the CJS/ESM distinction before Node ever sees it.
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "noEmit": true
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "dist-electron", "release", "electron/shell.ts"]
}
