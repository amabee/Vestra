{
  "name": "@vestra/nova",
  "version": "0.1.0",
  "private": true,
  "description": "Vestra Nova — the Vestra desktop application (Electron).",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dev": "pnpm run build:electron && cross-env NODE_ENV=development electron .",
    "package": "pnpm run build:electron && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.renderer.json",
    "clean": "rimraf dist-electron release .turbo"
  },
  "dependencies": {
    "@vestra/config": "workspace:*",
    "@vestra/core": "workspace:*",
    "@vestra/extension-host": "workspace:*",
    "@vestra/provider-sdk": "workspace:*",
    "@vestra/providers": "workspace:*",
    "@vestra/storage": "workspace:*",
    "@vestra/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vestra/tsconfig": "workspace:*",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "catalog:"
  },
  "build": {
    "appId": "app.vestra.nova",
    "productName": "Vestra Nova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*"
    ]
  }
}
