{
  "name": "@vestra/nova",
  "version": "0.1.0",
  "private": true,
  "description": "Vestra Nova — the Vestra desktop application (Electron).",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm run build:electron && pnpm run build:renderer",
    "start": "electron .",
    "fetch:mpv": "node scripts/fetch-mpv.mjs",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:electron": "pnpm run build:electron && wait-on -t 60000 tcp:127.0.0.1:5273 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n renderer,electron -c magenta,cyan \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
    "package": "pnpm run fetch:mpv && pnpm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p renderer/tsconfig.json",
    "clean": "rimraf dist-electron dist-renderer release .turbo"
  },
  "dependencies": {
    "@vestra/config": "workspace:*",
    "@vestra/core": "workspace:*",
    "@vestra/extension-host": "workspace:*",
    "@vestra/provider-sdk": "workspace:*",
    "@vestra/providers": "workspace:*",
    "@vestra/storage": "workspace:*",
    "@vestra/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "7zip-min": "^3.0.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vestra/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.14",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.3.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "wait-on": "^9.1.0",
    "zustand": "catalog:"
  },
  "build": {
    "appId": "app.vestra.nova",
    "productName": "Vestra Nova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "!**/*.map",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
