{
  "name": "@vestra/nova",
  "version": "0.1.0",
  "private": true,
  "description": "Vestra Nova — the Vestra desktop application (Electron).",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "node scripts/build-electron.mjs",
    "bundle:app": "node scripts/bundle-app.mjs",
    "build:all": "pnpm --filter @vestra/nova-app build && pnpm run bundle:app && pnpm run build:electron",
    "start": "electron .",
    "dev": "wait-on -t 120000 tcp:127.0.0.1:3000 && pnpm run dev:electron",
    "dev:electron": "pnpm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "pnpm run build:electron",
    "package": "pnpm run build:electron && pnpm run bundle:app && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json",
    "clean": "rimraf dist-electron release resources .turbo"
  },
  "dependencies": {
    "@vestra/config": "workspace:*",
    "@vestra/core": "workspace:*",
    "@vestra/extension-host": "workspace:*",
    "@vestra/storage": "workspace:*",
    "@vestra/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vestra/tsconfig": "workspace:*",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "app.vestra.nova",
    "productName": "Vestra Nova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/app",
        "to": "app"
      }
    ]
  }
}
