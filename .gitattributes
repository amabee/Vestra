# Normalise line endings: LF in the repository, native in the working tree.
# Without this, Windows checkouts commit CRLF and every file shows as modified
# on other platforms.
* text=auto eol=lf

# Scripts that must keep their platform's endings.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sh    text eol=lf

# Binary assets — never diff or normalise these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.mkv   binary
*.webm  binary
*.pdf   binary

# Lockfile: keep it in the repo but collapse it in diffs and reviews.
pnpm-lock.yaml -diff linguist-generated=true

# Keep GitHub's language stats focused on real source.
tooling/**       linguist-vendored=true
**/*.config.*    linguist-detectable=false
