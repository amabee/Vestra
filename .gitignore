# Dependencies
node_modules/
.pnpm-store/

# Build output
**/bin/
**/obj/
.next/
out/
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment — never commit real keys
.env
.env.local
.env.*.local

# Vestra runtime data (watchlist / history / progress JSON)
.vestra/
*.vestra-cache/
.vestra-preserved/

# Local developer binaries (mpv, ffmpeg) and scratch captures. The small
# scripts in here are worth keeping; the 112MB binaries next to them are not.
.tools/*
!.tools/*.mjs
!.tools/*.ps1
!.tools/*.cjs

# Third-party clones kept locally for reference only. Someone else's code under
# someone else's terms: read to understand a format, never vendored into ours.
# seanime-denshi ships no licence at all, so it must not land in an MIT repo.
Seanime-Providers/
seanime/

# Electron
apps/nova/release/
apps/nova/dist-electron/
apps/nova/dist-renderer/
# mpv, downloaded at package time by `pnpm --filter @vestra/nova fetch:mpv`.
# A separate GPL program: shipped beside the app, never committed.
apps/nova/vendor/
# The blanket `build/` rule above is meant for compiler output, but this folder
# holds the application icon that electron-builder and the tray both read.
# The directory has to be re-included before the files inside it can be.
!apps/nova/build/
!apps/nova/build/**
# Bundled Atlas standalone build, produced by `pnpm --filter @vestra/nova bundle:atlas`
apps/nova/resources/

# Expo
apps/pulse/.expo/
apps/pulse/.expo-shared/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/

# Preserved dev runtime data (watchlist, progress, settings) - never commit.
.vestra-preserved/


# Homarchuelos Shits
.hormachuelos

# Hallmark
.hallmark
