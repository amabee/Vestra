# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment — never commit real keys
.env
.env.local
.env.*.local

# Vestra runtime data (watchlist / history / progress JSON)
.vestra/
*.vestra-cache/
.vestra-preserved/

# Local developer binaries (mpv, ffmpeg). Never committed: they are separate
# GPL programs, and bundling one would extend that licence over this project.
.tools/

# Electron
apps/nova/release/
apps/nova/dist-electron/
apps/nova/dist-renderer/
# mpv, downloaded at package time by `pnpm --filter @vestra/nova fetch:mpv`.
# A separate GPL program: shipped beside the app, never committed.
apps/nova/vendor/
# Bundled Atlas standalone build, produced by `pnpm --filter @vestra/nova bundle:atlas`
apps/nova/resources/

# Expo
apps/pulse/.expo/
apps/pulse/.expo-shared/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/

# Preserved dev runtime data (watchlist, progress, settings) - never commit.
.vestra-preserved/
