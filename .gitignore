apps/nova/resources/

# Expo
apps/pulse/.expo/
apps/pulse/.expo-shared/

# Editor / OS
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.vitest/

# Preserved dev runtime data (watchlist, progress, settings) - never commit.
.vestra-preserved/
