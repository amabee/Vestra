# =============================================================================
# Vestra — environment template
# Copy to `.env.local` (Atlas) or `.env` (root) and fill in. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# TMDb — movies, TV shows, K-drama
# Get a key: https://www.themoviedb.org/settings/api
# TMDB_ACCESS_TOKEN (v4 bearer) is preferred; TMDB_API_KEY (v3) is the fallback.
# -----------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional self-hosted Vyla Movies/TV API. Leave blank to disable.
# Exact loopback HTTP (http://127.0.0.1:7860) or public HTTPS; optional /api prefix.
# Media URLs must remain public HTTPS: direct upstreams or an HTTPS media proxy.
VESTRA_VYLA_URL=
# Optional bearer token for YOUR reverse proxy; never put it in the URL.
VESTRA_VYLA_TOKEN=

# -----------------------------------------------------------------------------
# AniList — anime
# Public GraphQL queries need NO credentials. Nova ships its public OAuth
# client ID and uses browser sign-in; no client secret is needed by Nova.
# Maintainer-only override: register a client with redirect vestra://auth/anilist.
# -----------------------------------------------------------------------------
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=vestra://auth/anilist

# -----------------------------------------------------------------------------
# YouTube Data API v3
# Get a key: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Your own media server (optional)
# MEDIA_SERVER_KIND: "jellyfin" | "plex" | "none"
# -----------------------------------------------------------------------------
MEDIA_SERVER_KIND=none
MEDIA_SERVER_URL=http://localhost:8096
MEDIA_SERVER_API_KEY=

# -----------------------------------------------------------------------------
# qBittorrent Web UI (optional)
# Enable in qBittorrent: Tools > Options > Web UI
# Point this at YOUR OWN client. Vestra only controls it — it ships no indexers.
# -----------------------------------------------------------------------------
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# -----------------------------------------------------------------------------
# Local storage
# Where Vestra writes watchlist / history / progress JSON.
# Defaults to `<repo>/.vestra` on web and the OS app-data dir on desktop.
# -----------------------------------------------------------------------------
VESTRA_DATA_DIR=

# -----------------------------------------------------------------------------
# Public (browser-exposed) values — safe to ship to the client
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Vestra
NEXT_PUBLIC_APP_URL=http://localhost:3000
