{
  "name": "vestra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Vestra \u00e2\u20ac\u201d a unified entertainment platform for anime, movies, TV, K-drama, YouTube and local media.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test:startup": "node apps/nova/scripts/test-startup.mjs",
    "test:startup:ui": "node apps/nova/scripts/test-startup-ui.mjs",
    "build:app": "dotnet build apps/server/Vestra.Server.csproj -c Release --nologo && pnpm --filter @vestra/nova build",
    "build:server": "dotnet build apps/server/Vestra.Server.csproj -c Release --nologo",
    "test:server": "dotnet test tests/server-providers/Vestra.Providers.Tests.csproj -c Release --nologo",
    "test:server:bridge": "pnpm run build:server && node apps/nova/scripts/test-csharp-worker.mjs",
    "test:playback": "node apps/nova/scripts/test-remote-playback.mjs",
    "test:playback:quality": "node apps/nova/scripts/test-player-quality.mjs && node apps/nova/scripts/test-remote-playback.mjs",
    "test:playback:fonts": "node apps/nova/scripts/test-subtitle-fonts.mjs",
    "test:playback:subtitles": "node apps/nova/scripts/test-subtitle-metadata.mjs",
    "test:anime": "node apps/nova/scripts/test-anime-service.mjs && node apps/nova/scripts/test-anime-servers.mjs && node apps/nova/scripts/test-anime-runtime.mjs",
    "test:provider-ports": "pnpm --filter @vestra/extension-host exec vitest run src/examples/native-provider-ports.test.ts && node apps/nova/scripts/test-bundled-extensions.mjs",
    "test:desiflix:live": "node apps/nova/scripts/test-desiflix-live.mjs --live",
    "test:provider-ports:live": "node apps/nova/scripts/test-provider-ports-live.mjs --live",
    "release:version": "node apps/nova/scripts/release-version.mjs",
    "release:validate": "node apps/nova/scripts/validate-release.mjs",
    "test:updater:ipc": "node apps/nova/scripts/test-updater-ipc.mjs",
    "test:updater:ui": "node apps/nova/scripts/test-updater-ui.mjs",
    "test:settings:ui": "node apps/nova/scripts/test-settings-ui.mjs",
    "test:updater": "node apps/nova/scripts/test-app-updater.mjs",
    "test:settings:integrations:ui": "node apps/nova/scripts/test-settings-integrations-ui.mjs",
    "test:settings:integrations": "node apps/nova/scripts/test-settings-integrations.mjs",
    "test:anilist:login": "node apps/nova/scripts/test-anilist-login.mjs",
    "test:settings:expansion": "node apps/nova/scripts/test-settings-expansion.mjs && node apps/nova/scripts/test-settings-services.mjs",
    "test:settings": "node apps/nova/scripts/test-tmdb-settings.mjs && node apps/nova/scripts/test-settings-health.mjs && node apps/nova/scripts/test-torrent-settings.mjs",
    "test:extensions:install": "node apps/nova/scripts/test-extension-install.mjs",
    "test:extensions:install:live": "node apps/nova/scripts/test-extension-install.mjs --live",
    "test:streamplay": "node apps/nova/scripts/test-streamplay.mjs",
    "test:streamplay:live": "node apps/nova/scripts/test-streamplay.mjs --live",
    "test:anime:runtime": "node apps/nova/scripts/test-anime-runtime.mjs --native",
    "benchmark:anime": "node apps/nova/scripts/benchmark-anime-playback.mjs",
    "test:anime:live": "node apps/nova/scripts/test-anime-servers.mjs --live --native",
    "test:anime:playlists": "node apps/nova/scripts/test-anime-playlists.mjs",
    "test:anime:buffering": "node apps/nova/scripts/test-stream-buffering.mjs",
    "test:anime:repair": "node apps/nova/scripts/test-shonen-compat.mjs && node apps/nova/scripts/test-playback-errors.mjs && node apps/nova/scripts/test-playback-repair.mjs && node apps/nova/scripts/test-player-loading-ui.mjs",
    "test:anime:ui": "node apps/nova/scripts/test-anime-ui.mjs",
    "test:server:compat": "pnpm run build:server && node apps/nova/scripts/check-provider-compat.mjs",
    "check:providers:live": "pnpm run build:server && node apps/nova/scripts/check-provider-compat.mjs --live --repair",
    "check:manga:live": "pnpm run build:server && node apps/nova/scripts/check-manga-live.mjs",
    "test:manga:reader": "pnpm run build:server && node apps/nova/scripts/test-manga-reader.mjs",
    "test:manga:navigation": "node apps/nova/scripts/test-reader-navigation.mjs",
    "test:manga:ui": "pnpm --filter @vestra/nova build:renderer && node apps/nova/scripts/test-reader-ui.mjs",
    "test:manga:preload": "pnpm run build:server && node apps/nova/scripts/test-reader-images.mjs",
    "test:sources": "pnpm run build:server && node apps/nova/scripts/test-source-manager.mjs",
    "test:sources:remote": "node apps/nova/scripts/test-remote-sources.mjs",
    "test:server:packaged": "pnpm --filter @vestra/nova run publish:worker && pnpm --filter @vestra/nova run build:electron && pnpm --filter @vestra/nova run test:packaged-worker",
    "dev": "turbo run dev",
    "dev:nova": "turbo run dev --filter=@vestra/nova",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "dev:docs": "pnpm --filter @vestra/docs dev",
    "build:docs": "pnpm --filter @vestra/docs build",
    "test:anime:discovery": "node apps/nova/scripts/test-anime-discovery.mjs",
    "test:anime:hub": "node apps/nova/scripts/test-anime-hub.mjs",
    "test:anime:hub:ui": "node apps/nova/scripts/test-anime-hub-ui.mjs",
    "test:screen": "node apps/nova/scripts/test-screen-sources.mjs",
    "test:screen:ui": "node apps/nova/scripts/test-screen-ui.mjs",
    "test:moviebox": "pnpm --filter @vestra/extension-host exec vitest run src/examples/moviebox.test.ts src/net.test.ts",
    "test:moviebox:live": "node apps/nova/scripts/test-moviebox-live.mjs --live",
    "build:extension:kisskh": "node apps/nova/scripts/build-kisskh-extension.mjs",
    "test:kisskh": "node apps/nova/scripts/build-kisskh-extension.mjs && pnpm --filter @vestra/extension-host exec vitest run src/examples/kisskh.test.ts",
    "test:kisskh:live": "node apps/nova/scripts/test-kisskh-live.mjs --live",
    "test:vixsrc": "pnpm --filter @vestra/extension-host exec vitest run src/examples/vixsrc.test.ts",
    "test:vixsrc:live": "node apps/nova/scripts/test-vixsrc-live.mjs --live",
    "test:vyla": "node apps/nova/scripts/test-vyla-service.mjs",
    "test:archive": "pnpm --filter @vestra/extension-host exec vitest run src/examples/internet-archive.test.ts",
    "test:archive:live": "node apps/nova/scripts/test-archive-live.mjs --live",
    "test:security": "vitest run apps/nova/electron/security.test.ts packages/core/src/net-guard.test.ts && node apps/nova/scripts/test-security-ipc.mjs",
    "extensions:verify": "node apps/nova/scripts/foundry-snapshot.mjs --check",
    "extensions:sync": "node apps/nova/scripts/foundry-snapshot.mjs --sync",
    "extensions:update": "node apps/nova/scripts/foundry-snapshot.mjs --update",
    "test:foundry": "node --test apps/nova/scripts/test-foundry-snapshot.mjs && node apps/nova/scripts/test-bundled-extensions.mjs",
    "test:extensions:updates": "node apps/nova/scripts/test-extension-updates.mjs",
    "test:anilist:visibility": "node apps/nova/scripts/test-anilist-visibility.mjs",
    "test:ipc:queries": "node apps/nova/scripts/test-ipc-queries.mjs",
    "test:manga:pagination": "node apps/nova/scripts/test-manga-pagination.mjs",
    "test:anilist:sync": "node apps/nova/scripts/test-anilist-sync.mjs",
    "test:reliability": "node apps/nova/scripts/test-playback-reliability.mjs",
    "test:reliability:ui": "node apps/nova/scripts/test-playback-reliability-ui.mjs",
    "test:updater:prompt": "node apps/nova/scripts/test-update-prompt-ui.mjs",
    "test:foundry:packaged": "node apps/nova/scripts/test-packaged-foundry.mjs && node apps/nova/scripts/test-bundled-extensions.mjs --resources apps/nova/release/win-unpacked/resources"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "^4.1.12"
  }
}
