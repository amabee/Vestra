{
  "name": "vestra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Vestra — a unified entertainment platform for anime, movies, TV, K-drama, YouTube and local media.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:server": "dotnet build apps/server/Vestra.Server.csproj -c Release --nologo",
    "test:server": "dotnet test tests/server-providers/Vestra.Providers.Tests.csproj -c Release --nologo",
    "test:server:bridge": "pnpm run build:server && node apps/nova/scripts/test-csharp-worker.mjs",
    "test:playback": "node apps/nova/scripts/test-remote-playback.mjs",
    "test:playback:quality": "node apps/nova/scripts/test-player-quality.mjs && node apps/nova/scripts/test-remote-playback.mjs",
    "test:playback:subtitles": "node apps/nova/scripts/test-subtitle-metadata.mjs",
    "test:server:compat": "pnpm run build:server && node apps/nova/scripts/check-provider-compat.mjs",
    "check:providers:live": "pnpm run build:server && node apps/nova/scripts/check-provider-compat.mjs --live --repair",
    "check:manga:live": "pnpm run build:server && node apps/nova/scripts/check-manga-live.mjs",
    "test:manga:reader": "pnpm run build:server && node apps/nova/scripts/test-manga-reader.mjs",
    "test:manga:navigation": "node apps/nova/scripts/test-reader-navigation.mjs",
    "test:sources": "pnpm run build:server && node apps/nova/scripts/test-source-manager.mjs",
    "test:sources:remote": "node apps/nova/scripts/test-remote-sources.mjs",
    "test:server:packaged": "pnpm --filter @vestra/nova run publish:worker && pnpm --filter @vestra/nova run build:electron && pnpm --filter @vestra/nova run test:packaged-worker",
    "dev": "turbo run dev",
    "dev:nova": "turbo run dev --filter=@vestra/nova",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "vitest": "^3.2.7"
  }
}
